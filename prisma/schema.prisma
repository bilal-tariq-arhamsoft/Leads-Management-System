generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id             String      @id @default(cuid())
  firstName      String
  lastName       String?
  email          String      @unique
  phone          String?
  company        String?
  position       String?
  source         LeadSource?
  status         LeadStatus  @default(NEW)
  message        String?
  assignedUserId String?     @unique
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  assignedUser   User?       @relation(fields: [assignedUserId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([source])
  @@index([status, createdAt(sort: Desc)])
}

model User {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  passwordHash    String
  profileImageUrl String?
  position        UserPosition
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  assignedLead    Lead?

  @@map("user")
}

model LeadForm {
  id        String     @id @default(cuid())
  firstName String
  lastName  String?
  email     String
  phone     String?
  company   String?
  position  String?
  source    LeadSource
  status    LeadStatus @default(NEW)
  message   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@index([status])
  @@index([source])
  @@map("lead_form")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  LINKEDIN
  REFERRAL
}

enum UserPosition {
  ADMIN
  MANAGER
}
