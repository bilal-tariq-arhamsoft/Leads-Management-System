generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  LINKEDIN
  REFERRAL
}

model Lead {
  id          String      @id @default(cuid())

  // Basic Info
  firstName   String
  lastName    String?
  email       String      @unique
  phone       String?
  company     String?
  position    String?

  // Lead Details
  source      LeadSource?
  status      LeadStatus  @default(NEW)
  message     String?

  // Assignment (one manager per lead; each manager at most one lead)
  assignedUserId String? @unique
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  // Tracking
  isActive    Boolean     @default(true)

  // Dates
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([source])
  @@index([status, createdAt(sort: Desc)])
}

enum UserPosition {
  ADMIN
  MANAGER
}

model User {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  passwordHash     String
  profileImageUrl  String?
  position         UserPosition
  assignedLead Lead?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("user")
}

model LeadForm {
  id        String     @id @default(cuid())

  firstName String
  lastName  String?
  email     String
  phone     String?
  company   String?
  position  String?

  source    LeadSource
  status    LeadStatus @default(NEW)
  message   String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("lead_form")
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@index([status])
  @@index([source])
}